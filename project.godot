; Bannerworks — Godot 4.5.2, GDScript, Compatibility renderer.
config_version=5

[application]
config/name="Bannerworks"
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=402
window/size/viewport_height=874
window/size/window_width_override=482
window/size/window_height_override=1048
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.09, 0.12, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]
common/physics_ticks_per_second=30

[audio]
driver/enable_input=false
